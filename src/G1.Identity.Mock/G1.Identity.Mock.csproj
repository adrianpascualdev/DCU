<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="OpenApi/ContractDocument.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources/IdentityMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>IdentityMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources/IdentityMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>IdentityMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="G1.Identity.ContractTests" />
  </ItemGroup>

  <!-- T030: publicar el build ya generado; Node solo se usa en scripts/build-selector.sh / CI. -->
  <Target Name="PublishSelectorBuild" BeforeTargets="Build" Condition="'$(SkipSelectorBuild)' != 'true'">
    <PropertyGroup>
      <SelectorSourceDirectory>$(MSBuildProjectDirectory)/../G1.Identity.Mock.Ui/dist</SelectorSourceDirectory>
      <SelectorTargetDirectory>$(MSBuildProjectDirectory)/wwwroot/selector</SelectorTargetDirectory>
    </PropertyGroup>
    <ItemGroup>
      <SelectorBuildFile Include="$(SelectorSourceDirectory)/**/*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(SelectorBuildFile)"
      DestinationFiles="@(SelectorBuildFile->'$(SelectorTargetDirectory)/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(SelectorBuildFile)' != ''" />
  </Target>

</Project>
